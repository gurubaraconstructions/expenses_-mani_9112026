rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().active == true; }
    function owner() { return activeUser() && profile().role == 'owner'; }
    function accountant() { return activeUser() && profile().role == 'accountant'; }
    function supervisor() { return activeUser() && profile().role == 'supervisor'; }
    function assigned(site) { return activeUser() && site in profile().siteIds; }
    function canReadSite() { return owner() || accountant() || (supervisor() && assigned(resource.data.siteId)); }
    function canCreateSite() { return owner() || accountant() || (supervisor() && assigned(request.resource.data.siteId)); }
    function canUpdateSite() { return owner() || accountant() || (supervisor() && assigned(resource.data.siteId) && request.resource.data.siteId == resource.data.siteId); }

    match /users/{uid} {
      allow read: if owner() || (activeUser() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }
    // PIN lookup hashes and salted PIN verifiers are server-only.
    match /pinCredentials/{uid} { allow read, write: if false; }
    match /pinLoginLimits/{key} { allow read, write: if false; }

    match /attendance/{id} { allow read: if canReadSite(); allow create: if canCreateSite(); allow update: if canUpdateSite(); allow delete: if owner(); }
    match /materials/{id} { allow read: if canReadSite(); allow create: if canCreateSite(); allow update: if canUpdateSite(); allow delete: if owner(); }
    match /subcontractorStages/{id} { allow read: if canReadSite(); allow create: if canCreateSite(); allow update: if canUpdateSite(); allow delete: if owner(); }
    match /expenses/{id} { allow read: if canReadSite(); allow create: if canCreateSite(); allow update: if canUpdateSite(); allow delete: if owner(); }
    match /payments/{id} { allow read: if owner() || accountant(); allow create, update: if (owner() || accountant()) && request.resource.data.siteId in profile().siteIds; allow delete: if owner(); }
    match /{document=**} { allow read, write: if false; }
  }
}
